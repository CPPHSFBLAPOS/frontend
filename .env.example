# Copy to .env.local. These two are public by design (the key only works
# together with row-level security). VITE_SUPABASE_ANON_KEY is the project's
# Publishable key (sb_publishable_..., or the legacy anon key). Never put a
# secret here: every VITE_ variable ends up in the browser bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Where `netlify dev` (backend repo) serves the functions during development.
# The Vite dev server proxies /api/* there.
FUNCTIONS_DEV_URL=http://localhost:8888

# Optional. The sign-in screen accepts 6 to 10 digit codes either way; set
# this to the hosted project's Auth "Email OTP length" (6 by default) so a
# pasted or autofilled code of exactly that length signs in without
# pressing Continue.
# VITE_OTP_LENGTH=6
